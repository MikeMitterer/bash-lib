#!/usr/bin/env bash
#------------------------------------------------------------------------------
# post-commit — lokalen post-commit-Hook aus .git/hooks weiter aufrufen
#
# Aktiv über `git config core.hooksPath .githooks` (macht `make setup`). Damit
# liest git .git/hooks nicht mehr. Ein dort eingerichteter, nicht versionierter
# Hook (etwa der Jenkins-Trigger mit Zugangsdaten) läuft über diesen Aufruf
# weiter. Fehlt er, passiert nichts.
#
# Läuft er fehlerfrei, bleibt seine Ausgabe verborgen (etwa „job N at …“ von
# at); scheitert er, erscheint sie mit seinem Exit-Code.
#------------------------------------------------------------------------------

set -euo pipefail

LOCAL_HOOK="$(git rev-parse --git-common-dir)/hooks/post-commit"
readonly LOCAL_HOOK

[[ -x "${LOCAL_HOOK}" ]] || exit 0

# Datei statt $(…): ein Hintergrundprozess des Hooks hält sonst die Ausgabe offen.
OUTPUT="$(mktemp "${TMPDIR:-/tmp}/post-commit.XXXXXX")"
readonly OUTPUT
trap 'command rm -f -- "${OUTPUT}"' EXIT

rc=0
"${LOCAL_HOOK}" "$@" >"${OUTPUT}" 2>&1 || rc=$?
if [[ ${rc} -ne 0 ]]; then
    cat "${OUTPUT}" >&2
    echo "post-commit: lokaler Hook .git/hooks/post-commit endete mit Exit ${rc}" >&2
fi
exit "${rc}"
