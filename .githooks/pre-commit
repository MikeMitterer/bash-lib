#!/usr/bin/env bash
#------------------------------------------------------------------------------
# pre-commit — Nutzerdoku vor jedem Commit prüfen
#
# Aktiv über `git config core.hooksPath .githooks` (macht `make setup`).
# Richtet bei Bedarf mit `make setup` ein (require-setup, require-tools), prüft
# dann mit `make docs-check-only` und bricht den Commit ab, wenn die Einrichtung
# scheitert oder die Prüfung Probleme meldet; Hinweise lassen ihn durch. Ohne
# Probleme bleibt er still bis auf Warnzeilen (⚠), sonst erscheint die
# vollständige Ausgabe.
#
# Geprüft wird der vorgemerkte Stand, also genau das, was der Commit enthält:
# Der Hook schreibt den Index in ein temporäres Verzeichnis und lässt die
# Prüfung dort laufen, mit Git-Verzeichnis und Index dieses Repositorys.
# Nicht vorgemerkte Änderungen und neue, nicht vorgemerkte Dateien zählen
# deshalb nicht mit.
#
# Im Notfall umgehen: git commit --no-verify
#------------------------------------------------------------------------------

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
readonly ROOT
cd "${ROOT}"

# Bei `git commit -a` oder `git commit <pfad>` setzt git einen eigenen Index;
# ein relativer Pfad muss nach dem Wechsel ins Snapshot-Verzeichnis gelten.
if [[ -n "${GIT_INDEX_FILE:-}" && "${GIT_INDEX_FILE}" != /* ]]; then
    export GIT_INDEX_FILE="${ROOT}/${GIT_INDEX_FILE}"
fi

# Werkzeuge ohne die Git-Variablen des Hooks starten; pip und pipx schrieben
# sonst in den Index dieses Repositorys.
without_git() {
    env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE -u GIT_OBJECT_DIRECTORY \
        -u GIT_COMMON_DIR "$@"
}

# Einrichtung und Werkzeuge im Checkout, nicht in der Kopie: Fehlt etwas oder ist es
# veraltet, läuft make setup hier; in der Kopie richtete es die .venv auf den Temp-Ordner
# ein. Ohne die Doku-Prüfung gibt es keinen Commit (makefile-conventions).
if ! without_git make --no-print-directory -s -C "${ROOT}" require-setup require-tools; then
    echo
    echo "Commit abgebrochen: Einrichtung oder ProjectTools fehlt, die Doku ist nicht geprüft (siehe oben)."
    echo "Im Notfall: git commit --no-verify"
    exit 1
fi

SNAPSHOT="$(mktemp -d "${TMPDIR:-/tmp}/docs-check-index.XXXXXX")"
readonly SNAPSHOT
OUTPUT="$(mktemp "${TMPDIR:-/tmp}/docs-check.XXXXXX")"
readonly OUTPUT
trap 'command rm -rf -- "${SNAPSHOT}" "${OUTPUT}"' EXIT

git checkout-index --all --prefix="${SNAPSHOT}/"
# Die Werkzeuge aus .tools/ und die .venv dieses Checkouts gelten auch in der Kopie; bashlib
# --skill für SKILLS in .docs-check.conf.sh kommt aus bin/ der Kopie selbst.
for dir in .tools .venv; do
    if [[ -d "${ROOT}/${dir}" ]]; then ln -s "${ROOT}/${dir}" "${SNAPSHOT}/${dir}"; fi
done

GIT_DIR="$(git rev-parse --absolute-git-dir)"
export GIT_DIR
export GIT_WORK_TREE="${SNAPSHOT}"

if make --no-print-directory -C "${SNAPSHOT}" docs-check-only >"${OUTPUT}" 2>&1; then
    # Nur Warnungen; vor dem ⚠ kann ein Farbcode stehen.
    grep -E '⚠' "${OUTPUT}" || true
    exit 0
fi

cat "${OUTPUT}"
echo
echo "Commit abgebrochen: make docs-check meldet Probleme im vorgemerkten Stand (siehe oben)."
echo "Beheben, vormerken und erneut committen; im Notfall: git commit --no-verify"
exit 1
