pipeline {
    agent { label 'linux' }

    stages {
        stage('Prepare') {
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    ansiColor('xterm') {
                        sh 'make setup'
                    }
                }
            }
        }
        stage('CLI-Test') {
            
            steps {
                ansiColor('xterm') {
                    sh 'make test'
                }
            }
        }
    }
    post {
        always {
            ansiColor('xterm') {
                // Platzhalter
            }
        }
    }
}
