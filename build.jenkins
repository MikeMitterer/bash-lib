// Voraussetzungen des Agents: docs/development.md, Abschnitt „Jenkins“.
pipeline {
    agent { label 'linux' }

    stages {
        stage('Setup') {
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    ansiColor('xterm') {
                        sh 'make setup'
                    }
                }
            }
        }
        stage('Check') {
            steps {
                ansiColor('xterm') {
                    sh 'make check'
                }
            }
        }
        stage('Build') {
            steps {
                ansiColor('xterm') {
                    sh 'make build'
                }
            }
        }
        stage('Build-Check') {
            steps {
                ansiColor('xterm') {
                    sh 'make build-check'
                }
            }
        }
    }
}
